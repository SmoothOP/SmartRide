rules_version = '2';
// Prototype rules: anyone using the SmartRide site gets an (anonymous) sign-in,
// and only signed-in sessions can read or write. Raw unauthenticated API access is blocked.
// Production would lock writes down further and move booking/boarding logic into Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
